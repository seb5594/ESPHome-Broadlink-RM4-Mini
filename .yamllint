extends: default

ignore-from-file: .gitignore

rules:
  document-start: disable
  line-length: disable
  truthy: disable
  comments:
    min-spaces-from-content: 1
  # Commented-out alternatives in the configs sit at the level they apply to.
  comments-indentation: disable
  indentation:
    spaces: 2
    indent-sequences: true

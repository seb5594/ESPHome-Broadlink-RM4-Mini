# Copy to secrets.yaml (the ESPHome dashboard already has one) and fill in.
# Generate an API key with:  openssl rand -base64 32

wifi_ssid: "MyNetwork"
wifi_password: "my-wifi-password"
# wifi_domain: ".iot.lan"
fallback_ap_password: "at-least-8-characters"
api_encryption_key: "32-byte-base64-key-goes-here======"
